OPENROUTER_API_KEY=
COACH_PROXY_TOKEN=
# Opcional: cadeia "tenta em ordem" separada por vírgula. Default: os 3 free da visão.
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,thinkingmachines/inkling-2-small:free
# Opcional (legado, um só): OPENROUTER_MODEL=...
# Opcional: modelos do Go, em ordem. Default: glm-5.3-flash,mimo-v2.6-flash,deepseek-v4.1-flash.
# COACH_GO_MODELS=glm-5.3-flash,mimo-v2.6-flash,deepseek-v4.1-flash
# Opcional: timeout por tentativa (explain/review). Default: 15000.
# COACH_UPSTREAM_TIMEOUT_MS=15000
# Opcional: free-answer tem orçamento menor que os 25 s do app. Defaults: 12000 e 18000.
# COACH_FREE_ANSWER_TIMEOUT_MS=12000
# COACH_FREE_ANSWER_BUDGET_MS=18000
